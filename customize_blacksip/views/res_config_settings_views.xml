<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_cpe" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.l10n_pe_cpe</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='connectors_setting_container']" position="after">
                    <block title="BlackSIP" id="blacksip_block">
                        <setting id="blacksip_sale_template" title="Black SIP Sale Template" help="Enable Black SIP sale template">
                            <field name="blacksip_sale_template"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
