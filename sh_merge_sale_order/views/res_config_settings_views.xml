<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="merge_sale_res_config_settings_inherit_view" model="ir.ui.view">
        <field name="name">sale.res.config.settings.inherit.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']//block[@name='catalog_setting_container']"
                position="after">
                <block title="Merge Sale Order Quantity" >
                    <setting company_dependent="1">
                        <field name="sh_so_sub_merge_qty" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>