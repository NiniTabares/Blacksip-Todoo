<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- merge sale orders wizards-->
    <record id="sh_merge_sale_order_wizard_form" model="ir.ui.view">
        <field name="name">sh.merge.sale.order.wizard.form</field>
        <field name="model">sh.mso.merge.sale.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Merge Sale Orders">
                <group>
                    <group>
                        <field name="sale_order_ids" widget="many2many_tags" invisible="1" />
                        <field name="partner_id" />
                        <field name="sale_order_id"
                            domain="[('state','in',['draft', 'sent']),('partner_id','=',partner_id),('id','not in',sale_order_ids)]" />
                        <field name="merge_type" widget="radio" />
                        <field name="sh_is_qty_available_so" invisible="1" />
                    </group>
                    <group>
                        <field name="sh_is_merge_chatter_so" />
                    </group>
                </group>
                <notebook>
                    <page string="Merge Lines" name="merge_line_ids">
                        <field name="merge_line_ids" widget="section_and_note_one2many" mode="list">
                            <list editable="bottom" create="false" delete="false">
                                <field name="sale_order_id" required="1" readonly="1" force_save="1" />
                                <field name="product_id" readonly="1" force_save="1" required="1" />
                                <field name="qty" required="1" />
                                <field name="qty_available" readonly="1"
                                    column_invisible="not parent.sh_is_qty_available_so" />
                                <field name="sale_order_line_id" column_invisible="1" />
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button class="btn-primary" name="action_merge_sale_order" type="object"
                        string="Merge" />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="sh_merge_sale_order_multi_action" model="ir.actions.act_window">
        <field name="name">Merge Sale Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sh.mso.merge.sale.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sh_merge_sale_order_wizard_form" />
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="binding_view_types">list</field>
        <field name="target">new</field>
    </record>
</odoo>